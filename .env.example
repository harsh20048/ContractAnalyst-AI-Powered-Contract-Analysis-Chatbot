# HuggingFace PDF Extraction Framework Environment Configuration

# =============================================================================
# Application Settings
# =============================================================================
DEBUG=false
LOG_LEVEL=INFO
SECRET_KEY=your-secret-key-change-this-in-production

# =============================================================================
# Server Configuration
# =============================================================================
HOST=0.0.0.0
PORT=8000
WORKERS=1

# =============================================================================
# Model Configuration
# =============================================================================
# Default models for different tasks
DEFAULT_MODEL=microsoft/DialoGPT-medium
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EXTRACTION_MODEL=facebook/bart-large-cnn

# Model inference parameters
MAX_LENGTH=512
TEMPERATURE=0.7
TOP_P=0.9

# =============================================================================
# PDF Processing Configuration  
# =============================================================================
# Maximum file size in bytes (50MB default)
MAX_FILE_SIZE=52428800

# Allowed file extensions (comma-separated)
ALLOWED_EXTENSIONS=.pdf

# Text chunking parameters
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# =============================================================================
# Vector Database Configuration
# =============================================================================
VECTOR_DB_PATH=./vector_db
SIMILARITY_THRESHOLD=0.7

# =============================================================================
# Storage Configuration
# =============================================================================
UPLOAD_DIR=./uploads
PROCESSED_DIR=./processed

# =============================================================================
# Security Configuration
# =============================================================================
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =============================================================================
# Cache Configuration
# =============================================================================
# Cache TTL in seconds (1 hour default)
CACHE_TTL=3600

# =============================================================================
# Optional: External Services
# =============================================================================
# Uncomment and configure if using external services

# Redis Configuration (for caching)
# REDIS_URL=redis://localhost:6379/0

# Database Configuration (for persistence)
# DATABASE_URL=postgresql://user:password@localhost:5432/hf_framework

# Monitoring and Logging
# SENTRY_DSN=your-sentry-dsn-here
# LOG_FILE_PATH=./logs/app.log

# =============================================================================
# GPU Configuration
# =============================================================================
# Set to 'cuda' to use GPU if available, 'cpu' to force CPU
# DEVICE=auto

# =============================================================================
# API Keys (if needed for external model providers)
# =============================================================================
# HUGGINGFACE_API_TOKEN=your-hf-token-here
# OPENAI_API_KEY=your-openai-key-here

# =============================================================================
# Development Configuration
# =============================================================================
# Set to true for development mode
DEV_MODE=false

# Enable/disable automatic model downloads
AUTO_DOWNLOAD_MODELS=true

# Model cache directory
MODEL_CACHE_DIR=./model_cache